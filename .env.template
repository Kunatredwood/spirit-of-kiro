# AWS Configuration
# AWS credentials for accessing Bedrock and other AWS services
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=us-east-2

# Amazon Cognito Configuration
# These values are created when you run: ./scripts/deploy-cognito.sh game-auth
COGNITO_USER_POOL_ID=your_cognito_user_pool_id
COGNITO_CLIENT_ID=your_cognito_client_id
COGNITO_USER_POOL_ARN=your_cognito_user_pool_arn

# DynamoDB Configuration (for local development)
# When running with Docker/Podman, this should point to the dynamodb-local container
DYNAMODB_ENDPOINT=http://dynamodb-local:8000

# Optional: AWS Session Token (if using temporary credentials)
# AWS_SESSION_TOKEN=your_session_token_here
